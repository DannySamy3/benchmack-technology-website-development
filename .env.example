# Copy to .env.local (development) or .env.production (server, see DEPLOYMENT.md) and fill in.

# Contact form email delivery (https://resend.com)
# 1. Create a Resend account and verify the benchmacktech.co.tz domain (adds DNS records).
# 2. Create an API key and paste it below.
RESEND_API_KEY=
# Sender address on the verified domain
CONTACT_FROM_EMAIL="Benchmack Website <website@benchmacktech.co.tz>"
# Inbox that receives enquiries (optional, defaults to support@benchmacktech.co.tz)
CONTACT_TO_EMAIL=

# Spam protection with Cloudflare Turnstile (free): https://dash.cloudflare.com/?to=/:account/turnstile
# Set both keys, or leave both empty to disable. The site key is built into the page,
# so rebuild after changing it (docker compose --env-file .env.production up -d --build).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
